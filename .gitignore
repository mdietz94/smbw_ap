# Claude Code state (per-developer) — but DO track shared project skills.
# `.claude/*` (not `.claude/`) ignores the dir's contents while still letting
# git traverse in to honor the `!.claude/skills/` re-include below; settings,
# worktrees, and plans stay ignored.
.claude/*
!.claude/skills/

# Editor/IDE noise
.vscode/
.idea/
*.swp

# Python noise for manual_smbwonder_zim/
__pycache__/
*.pyc
*.pyo
.pytest_cache/

# vendor/Archipelago is a git submodule (pinned to commit 799e0b7b, matching
# the smo_archipelago sister project).  See .gitmodules.
venv/

# SMBW Client log (rotated per-launch, written by Utils.init_logging)
SMBWClient.txt

# Build output for the packaged .apworld zip (scripts/install_apworld.py)
build/
release-artifacts/
vendor/Archipelago/custom_worlds/smbwonder.apworld

# Hakkun pre-packaged libc/libc++/libunwind. setup_libcxx_prepackaged.py
# downloads + extracts these into switch-mod/lib/std on first configure; the
# trees are hundreds of MiB and would bloat the repo.
switch-mod/lib/std/

# OS noise
Thumbs.db
.DS_Store
